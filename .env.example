# SponsorDesk Environment Configuration

# 1. Supabase (PostgreSQL Database & Authentication)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# SUPABASE_SERVICE_ROLE_KEY is optional, only needed if executing elevated admin tasks
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Google Gemini API (AI Pitch Studio)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# 3. Application URL (for production redirects & invitations)
NEXT_PUBLIC_APP_URL=http://localhost:3000
